<UserControl x:Class="DiscImageStudio.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:vm="clr-namespace:DiscImageStudio.ViewModels">
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <StackPanel Margin="{StaticResource PagePadding}">
            <controls:PageHeader Title="Export" Badge="{Binding FamilyLabel}"
                                 Workspace="{x:Static vm:Workspace.Export}"
                                 Hint="ExportDesign[EN]Burn[EN]。[EN]“Project Settings”[EN]">
                <controls:PageHeader.Actions>
                    <Button Style="{StaticResource CompactButton}" Content="[EN]：Burn"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:Workspace.Burn}" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <!-- Source: the composite the design page renders. Export always writes the
                 project composite as-is, so this card applies unconditionally (the burn
                 workspace is where a different material can be picked). -->
            <controls:SectionCard Header="[EN]" IconKind="Image" Margin="0,0,0,24">
                <StackPanel>
                    <!-- The generation geometry is edited in the project settings, so the source
                         row carries the jump to its owner. -->
                    <controls:SourceChip Text="{Binding SourceSummary}">
                        <controls:SourceChip.Actions>
                            <Button Style="{StaticResource CompactButton}" Content="Project Settings…"
                                    Command="{Binding OpenProjectSettingsCommand}"
                                    ToolTip="[EN]（[EN]、sectors、Track Pitch）[EN]Project Settings[EN]。" />
                        </controls:SourceChip.Actions>
                    </controls:SourceChip>
                    <!-- Empty source: the sentence above says what is missing; this says where
                         to fix it. Once layers exist the jump goes away with the gap. -->
                    <controls:VisibilityGate IsOpen="{Binding HasLayers}" Inverted="True">
                        <Button Style="{StaticResource CompactButton}" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Content="[EN]DesignImport[EN]"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Workspace.Design}" />
                    </controls:VisibilityGate>
                </StackPanel>
            </controls:SectionCard>

            <!-- The artifact's file options. The on-disc folder (Accompanying Files) is configured on
                 the design page next to the composite; this card only names the output file. -->
            <controls:SectionCard Header="[EN]" IconKind="Folder">
                <StackPanel>
                    <controls:VisibilityGate IsOpen="{Binding IsCd}">
                        <StackPanel>
                            <controls:PathField Label="{Binding State.CdOutputLabel}"
                                                Text="{Binding State.CdOutputPath}"
                                                ButtonLabel="[EN]…"
                                                Hint="{Binding State.CdOutputHint}"
                                                Command="{Binding BrowseOutputCommand}" />
                            <controls:VisibilityGate IsOpen="{Binding State.HasCdFiles}">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="[EN]" />
                                    <TextBox Text="{Binding State.CdVolumeLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                                </StackPanel>
                            </controls:VisibilityGate>
                            <controls:VisibilityGate IsOpen="{Binding State.IsCdAudioMode}">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2"
                                               Text="CD-DA [EN]" />
                                    <controls:InterleaveToggle IsChecked="{Binding State.CdInterleave}"
                                                               Hint="[EN]audio track[EN] CD-DA standard[EN]Delayed interleaving。[EN]。"
                                                               AutomationProperties.Name="[EN] CD-DA Delayed interleaving" />
                                    <controls:VisibilityGate IsOpen="{Binding State.IsCdWaveOutput}" Margin="0,12,0,0">
                                        <CheckBox Content="[EN]Export CUE [EN]" IsChecked="{Binding State.CdWriteCue}" />
                                    </controls:VisibilityGate>
                                </StackPanel>
                            </controls:VisibilityGate>
                        </StackPanel>
                    </controls:VisibilityGate>

                    <controls:VisibilityGate IsOpen="{Binding IsDvd}">
                        <StackPanel>
                            <controls:PathField Label="[EN] ISO"
                                                Text="{Binding State.DvdOutputPath}"
                                                ButtonLabel="[EN]…"
                                                Command="{Binding BrowseOutputCommand}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="[EN]" />
                            <TextBox Text="{Binding State.DvdVolumeLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                        </StackPanel>
                    </controls:VisibilityGate>

                    <controls:VisibilityGate IsOpen="{Binding IsBluRay}">
                        <StackPanel>
                            <controls:PathField Label="[EN] ISO"
                                                Text="{Binding State.BdOutputPath}"
                                                ButtonLabel="[EN]…"
                                                Command="{Binding BrowseOutputCommand}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="[EN]" />
                            <TextBox Text="{Binding State.BdVolumeLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                        </StackPanel>
                    </controls:VisibilityGate>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding GenerateButtonText}"
                                Command="{Binding GenerateCommand}" />
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Text="[EN]Disc Media。" />
                    </StackPanel>
                </StackPanel>
            </controls:SectionCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
