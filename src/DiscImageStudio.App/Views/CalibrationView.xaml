<UserControl x:Class="DiscImageStudio.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:DiscImageStudio.ViewModels"
             SizeChanged="OnViewSizeChanged">
    <!-- Stage + step inspector: the photo canvas is a monitor (toolbar in the header, legend
         above the status footer); the three-step column is a guided disclosure where the
         active step is the expanded one. -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Grid.Row="0" Title="Assisted Calibration"
                             Workspace="{x:Static vm:Workspace.Calibration}"
                             Hint="[EN] Disc Image Studio [EN]，[EN]OKDisc Media[EN]" />
        <!-- One scroll surface: in the wide layout the work area is exactly the viewport tall
             (the step column is an accordion that never grows past it), in the narrow layout
             it stacks and the page scrolls as one. -->
        <ScrollViewer x:Name="WorkScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnWorkScrollChanged"
                      SizeChanged="OnWorkspaceSizeChanged" controls:ScrollMaskBehavior.Enabled="True">
            <Grid x:Name="WorkArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="GapColumn" Width="16" />
                    <ColumnDefinition x:Name="StepsColumn" Width="{StaticResource SidePanelWidth}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="StageRow" Height="*" />
                    <RowDefinition x:Name="StepsRow" Height="Auto" />
                </Grid.RowDefinitions>

                <controls:MonitorCard x:Name="StageCard" Grid.Column="0"
                                      Title="calibration[EN]" IconKind="Image"
                                      StatusText="{Binding SelectionDescription, ElementName=PhotoCanvas}">
                    <controls:MonitorCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Click="OnZoomOut" ToolTip="[EN]"
                                    Margin="0,0,4,0" AutomationProperties.Name="[EN]">
                                <iconPacks:PackIconLucide Kind="Minus" Width="16" Height="16"
                                                          Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="OnZoomIn" ToolTip="[EN]"
                                    Margin="0,0,8,0" AutomationProperties.Name="[EN]">
                                <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16"
                                                          Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                            <Button Content="[EN]" Style="{StaticResource CompactButton}"
                                    Click="OnResetView" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ViewDescription, ElementName=PhotoCanvas}"
                                       Style="{StaticResource CompactText}" VerticalAlignment="Center"
                                       MinWidth="42" Margin="0,0,8,0" />
                            <CheckBox Content="View Burn Pattern" IsChecked="{Binding ShowTargetPreview}"
                                      Style="{StaticResource CompactCheckBox}" VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <controls:VisibilityGate IsOpen="{Binding IsPhotoStep}">
                                <CheckBox Content="[EN]rectification[EN]" IsChecked="{Binding PreviewRectification, Mode=TwoWay}"
                                          IsEnabled="{Binding IsRectificationReady}"
                                          Style="{StaticResource CompactCheckBox}" VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                            </controls:VisibilityGate>
                            <controls:VisibilityGate IsOpen="{Binding IsTraceStep}">
                                <CheckBox Content="[EN]fitting[EN]" IsChecked="{Binding ShowPrediction}"
                                          Style="{StaticResource CompactCheckBox}" VerticalAlignment="Center" />
                            </controls:VisibilityGate>
                        </StackPanel>
                    </controls:MonitorCard.Actions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:CalibrationPhotoCanvas x:Name="PhotoCanvas" Grid.Row="0" Margin="1,0"
                            FallbackImage="{Binding TargetImage}" TargetCanvasRadiusMm="{Binding CanvasOuterRadiusMm}"
                            IsPhotoStep="{Binding IsPhotoStep}" IsRectificationPreview="{Binding PreviewRectification}"
                            IsTargetPreview="{Binding ShowTargetPreview}"
                            CanvasRadiusMm="{Binding PhotoCanvasRadiusMm}"
                            BoundaryPoints="{Binding PhotoBoundaryPoints}" BoundaryContours="{Binding PhotoBoundaryContours}"
                            BoundaryEditedCommand="{Binding BoundaryEditedCommand}"
                            TracePoints="{Binding TracePoints}" TraceEditedCommand="{Binding TraceEditedCommand}"
                            SelectedTraceArm="{Binding SelectedTraceArm}" PredictionContours="{Binding CrossPredictionContours}"
                            OutlierTracePointIndices="{Binding OutlierTracePointIndices}"
                            ShowPrediction="{Binding ShowPrediction}"
                            ToolTip="Scroll wheel to zoom，Right-click to pan。[EN]；[EN]Add[EN]，Delete Delete[EN]。">
                            <controls:CalibrationPhotoCanvas.Style>
                                <Style TargetType="controls:CalibrationPhotoCanvas">
                                    <Setter Property="Image" Value="{Binding PhotoImage}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTraceStep}" Value="True">
                                            <Setter Property="Image" Value="{Binding RectifiedPhoto}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewRectification}" Value="True">
                                            <Setter Property="Image" Value="{Binding RectifiedPhoto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:CalibrationPhotoCanvas.Style>
                        </controls:CalibrationPhotoCanvas>
                        <StackPanel Grid.Row="1" Margin="12,8,12,10">
                            <!-- One legend per step: the colour key lives here and nowhere else,
                                 as swatches instead of colour words. -->
                            <controls:VisibilityGate IsOpen="{Binding IsPhotoStep}">
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Ellipse Style="{StaticResource LegendDot}"
                                                 Fill="{StaticResource CalibrationEdgeBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="[EN]" Style="{StaticResource LegendLabel}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource LegendDot}"
                                                 Fill="{StaticResource CalibrationHubOutlineBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="[EN]" Style="{StaticResource LegendLabel}" />
                                    </StackPanel>
                                </WrapPanel>
                            </controls:VisibilityGate>
                            <controls:VisibilityGate IsOpen="{Binding IsTraceStep}">
                                <WrapPanel>
                                    <Button Content="Delete[EN]" Click="OnRemoveTracePoint"
                                            Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
                                    <Button Content="[EN]" Command="{Binding ClearTracesCommand}"
                                            Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding TraceSummary}" Style="{StaticResource CompactText}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Ellipse Style="{StaticResource LegendDot}"
                                                 Fill="{StaticResource CalibrationTraceBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="[EN]" Style="{StaticResource LegendLabel}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Ellipse Style="{StaticResource LegendDot}"
                                                 Fill="{StaticResource CalibrationPredictionBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="[EN]" Style="{StaticResource LegendLabel}" />
                                    </StackPanel>
                                    <!-- Only appears when the fit marks points whose distance
                                         to the predicted curve exceeds the noise allowance. -->
                                    <controls:VisibilityGate IsOpen="{Binding HasOutlierPoints}"
                                                             VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource LegendDot}"
                                                     Fill="{StaticResource DangerBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="Large Deviation" Style="{StaticResource LegendLabel}" />
                                        </StackPanel>
                                    </controls:VisibilityGate>
                                </WrapPanel>
                            </controls:VisibilityGate>
                        </StackPanel>
                    </Grid>
                </controls:MonitorCard>

                <!-- Guided disclosure as an accordion: only one step is expanded and its row
                     is the star, so the expanded card takes exactly the height the two
                     collapsed headers leave over and all three stay on screen. -->
                <Grid x:Name="StepsPanel" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="StepOneRow" Height="Auto" />
                        <RowDefinition x:Name="StepTwoRow" Height="Auto" />
                        <RowDefinition x:Name="StepThreeRow" Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Stage 1 is the disc itself: without a burned target there is nothing
                         to photograph. It starts expanded and active; installing a target
                         finishes it and hands the column to stage 2. -->
                    <controls:StepCard StepNumber="1" StepTitle="Generate Calibration Disc" Grid.Row="0" Margin="0,0,0,12"
                                       State="{Binding StepOneState}"
                                       IsExpanded="{Binding StepOneExpanded, Mode=TwoWay}">
                            <StackPanel>
                                <!-- The target follows the project family (no manual disc-type
                                     switch): the line under the button names the parameters a
                                     new target is built from. -->
                                <Button Content="[EN]New[EN]" Command="{Binding CreateTargetCommand}"
                                        Style="{StaticResource CompactPrimaryButton}" HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10" />
                                <TextBlock Text="{Binding CurrentParametersSummary}" Style="{StaticResource CompactHint}"
                                           Margin="0,0,0,10" />

                                <!-- Two delivery paths, named by what the user does next:
                                     burn here, or take a generated file to another burner. -->
                                <TextBlock Text="Burn" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <Button Content="[EN]streamingBurn" Command="{Binding StreamBurnCommand}"
                                        Style="{StaticResource CompactButton}" HorizontalAlignment="Left"
                                        ToolTip="[EN]Burn[EN]，[EN]。" />

                                <TextBlock Text="[EN]Burn" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <TextBlock Text="[EN]audio track，[EN]Burn[EN]。"
                                           Style="{StaticResource CompactHint}" Margin="0,0,0,8" />
                                <controls:PathField Compact="True" Margin="0,0,0,12"
                                                    Text="{Binding OutputPath}" ButtonLabel="[EN]"
                                                    Command="{Binding BrowseOutputCommand}" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="[EN]／audio track" Command="{Binding GenerateImageCommand}"
                                            Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
                                    <Button Content="Export[EN] PNG" Command="{Binding ExportPngCommand}"
                                            Style="{StaticResource CompactButton}" />
                                </WrapPanel>

                                <Expander Header="calibration[EN]（[EN]）" IsExpanded="False">
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Savecalibration[EN]" Command="{Binding SaveSessionCommand}"
                                                Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
                                        <Button Content="Opencalibration[EN]" Command="{Binding OpenSessionCommand}"
                                                Style="{StaticResource CompactButton}" />
                                    </WrapPanel>
                                </Expander>
                            </StackPanel>
                        </controls:StepCard>

                        <controls:StepCard StepNumber="2" StepTitle="[EN]rectification" Grid.Row="1" Margin="0,0,0,12"
                                           State="{Binding StepTwoState}"
                                           IsExpanded="{Binding StepTwoExpanded, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="[EN]、[EN]。[EN]，[EN]；[EN]。"
                                           Style="{StaticResource CompactHint}" Margin="0,0,0,8" />
                                <Button Content="ImportDisc Media[EN]" Command="{Binding ImportPhotoCommand}"
                                        Style="{StaticResource CompactPrimaryButton}" Margin="0,0,0,8"
                                        HorizontalAlignment="Stretch" />
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Disc Media[EN]" Style="{StaticResource CompactText}" VerticalAlignment="Center"
                                               DockPanel.Dock="Left" Margin="0,0,10,0" />
                                    <ComboBox Style="{StaticResource CompactComboBox}"
                                              ItemsSource="{Binding PhysicalDiscSizeChoices}" SelectedItem="{Binding SelectedPhysicalDiscSize, Mode=TwoWay}" DisplayMemberPath="Label" />
                                </DockPanel>
                                <Button Content="Calculate Rectification" Command="{Binding RectifyPhotoCommand}"
                                        Style="{StaticResource CompactButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                <Button Content="[EN]rectification，[EN]" Command="{Binding ConfirmRectificationCommand}"
                                        IsEnabled="{Binding IsRectificationReady}"
                                        Style="{StaticResource CompactPrimaryButton}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding RectificationSummary}" Style="{StaticResource CompactHint}" Margin="0,10,0,0" />
                            </StackPanel>
                        </controls:StepCard>

                        <controls:StepCard StepNumber="3" StepTitle="[EN]" Grid.Row="2"
                                           State="{Binding StepThreeState}"
                                           IsExpanded="{Binding StepThreeExpanded, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="[EN]，[EN] 16 [EN]。"
                                           Style="{StaticResource CompactHint}" Margin="0,0,0,8" />
                                <Button Content="[EN]" Command="{Binding BackToPhotoCommand}"
                                        Style="{StaticResource CompactButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                <controls:VisibilityGate IsOpen="{Binding IsDvdTarget}">
                                    <StackPanel Margin="0,0,0,10">
                                        <CheckBox IsChecked="{Binding FitDvdPitch, Mode=TwoWay}" Content="fitting DVD [EN]Track Pitch[EN]"
                                                  Style="{StaticResource CompactCheckBox}" Margin="0,0,0,8" />
                                        <TextBlock Text="[EN] 16 [EN]，[EN]Burn[EN] 60% [EN]。"
                                                   Style="{StaticResource CompactHint}" />
                                    </StackPanel>
                                </controls:VisibilityGate>
                                <!-- Auto is the useful default; a manual bound is a diagnostic
                                     escape hatch, so it lives folded instead of occupying the
                                     card on every fit. The header still names the current mode. -->
                                <Expander Header="{Binding SearchRangeHeader}" IsExpanded="False"
                                          FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                          Margin="0,0,0,10">
                                    <StackPanel>
                                        <ComboBox Style="{StaticResource CompactComboBox}"
                                                  ItemsSource="{Binding CoarseSearchRangeChoices}"
                                                  SelectedItem="{Binding SelectedCoarseSearchRange, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                </Expander>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Invert Parameters" Command="{Binding SolveCommand}"
                                            Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Cancel[EN]" Command="{Binding CancelCommand}"
                                            Style="{StaticResource CompactButton}" />
                                </WrapPanel>
                                <ComboBox Style="{StaticResource CompactComboBox}" ItemsSource="{Binding CoarseCandidates}"
                                          SelectedItem="{Binding SelectedCoarseCandidate, Mode=TwoWay}" DisplayMemberPath="Label"
                                          MaxDropDownHeight="180" Margin="0,0,0,8" ToolTip="[EN]" />
                                <!-- One status line: FitAssessment carries the current verdict;
                                     failures log their details to the log page. -->
                                <TextBlock Text="{Binding FitAssessment}" Style="{StaticResource CompactHint}" Margin="0,0,0,10" />
                                <CheckBox IsChecked="{Binding ContourConfirmed, Mode=TwoWay}" Style="{StaticResource CompactCheckBox}" Margin="0,0,0,10">
                                    <TextBlock Text="[EN]，[EN]" TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Content="[EN]calibration[EN]" Command="{Binding ApplyParametersCommand}"
                                        Style="{StaticResource CompactPrimaryButton}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </controls:StepCard>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
